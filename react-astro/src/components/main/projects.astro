---
import ProjectListButton from "@/components/project-list-button";
import { relevantProjects } from "@/lib/projects";
import ProjectCard from "@/components/project-card.astro";
import styles from "./Main.module.css";
---

<section class={styles.section}>
  <h2 class={styles.sectionHeading}>Projects</h2>
  <div class="flex flex-wrap gap-4 sm:w-fit">
    {relevantProjects.map((project) => <ProjectCard {project} />)}
  </div>
  <ProjectListButton />
</section>
