---
import {
  AstroSkill,
  CssSkill,
  CypressSkill,
  DockerSkill,
  FastApiSkill,
  FirebaseSkill,
  GithubActionsSkill,
  HtmlSkill,
  NextJsSkill,
  PostgreSqlSkill,
  PyTestSkill,
  PythonSkill,
  ReactSkill,
  RedisSkill,
  RenderSkill,
  TailwindCssSkill,
  TypeScriptSkill,
  VercelSkill,
  VitestSkill,
} from "@/components/skills";
import styles from "./Main.module.css";
---

<section class={styles.section}>
  <h2 class={styles.sectionHeading}>Technologies</h2>
  <div class="flex flex-col gap-2">
    <h3 class="min-w-30 font-semibold">Frontend</h3>
    <div class="flex flex-wrap gap-2">
      <HtmlSkill client:load />
      <CssSkill client:load />
      <TypeScriptSkill client:load />
      <TailwindCssSkill client:load />
      <ReactSkill client:load />
      <NextJsSkill client:load />
      <AstroSkill client:load />
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="min-w-30 font-semibold">Backend</h3>
    <div class="flex flex-wrap gap-2">
      <PythonSkill client:load />
      <FastApiSkill client:load />
      <FirebaseSkill client:load />
      <PostgreSqlSkill client:load />
      <RedisSkill client:load />
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="min-w-30 font-semibold">Automation & Deployment</h3>
    <div class="flex flex-wrap gap-2">
      <GithubActionsSkill client:load />
      <DockerSkill client:load />
      <VercelSkill client:load />
      <RenderSkill client:load />
      <VitestSkill client:load />
      <CypressSkill client:load />
      <PyTestSkill client:load />
    </div>
  </div>
</section>
