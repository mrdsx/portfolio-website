---
import SVGTooltip from "@/components/svg-tooltip";
import {
  Card,
  CardBadges,
  CardDescription,
  CardFooter,
  CardGithubLink,
  CardHeader,
  CardImage,
  CardProjectLink,
  CardSkills,
  CardTitle,
} from "@/components/ui/card";
import type { Project } from "@/lib/projects";

type Props = {
  project: Project;
  showBadges?: boolean;
};

const { project, showBadges = false } = Astro.props;
---

<Card>
  <CardHeader>
    {
      showBadges && (
        <CardBadges>
          {project.badges.map((badge) => {
            const Badge = badge;
            return <Badge />;
          })}
        </CardBadges>
      )
    }
    <CardImage src={project.image} alt={project.name} />
    <CardTitle>{project.name}</CardTitle>
    <CardDescription>{project.description}</CardDescription>
  </CardHeader>
  <CardSkills>
    {
      project.techStack.map((tech) => (
        <SVGTooltip client:visible content={tech.title}>
          <tech.icon />
        </SVGTooltip>
      ))
    }
  </CardSkills>
  <CardFooter>
    <CardGithubLink githubURL={project.githubURL} />
    <CardProjectLink projectURL={project.projectURL} />
  </CardFooter>
</Card>
