---
import PersonalBadge from "@/components/badges/personal";
import DevelopingBadge from "@/components/badges/developing";
import ProprietaryBadge from "@/components/badges/proprietary";
import ToyProjectBadge from "@/components/badges/toy-project";
import GoBackButton from "@/components/go-back-button";
import ProjectCard from "@/components/project-card.astro";
import RootLayout from "@/components/root-layout.astro";
import { projects } from "@/lib/projects";
---

<RootLayout className="flex flex-col items-start gap-4">
  <GoBackButton href="/" />
  <div class="space-y-2">
    <h1 class="text-xl font-bold">Project list ({projects.length})</h1>
    <section class="mb-4 flex flex-col">
      <p>
        <DevelopingBadge /> - project is under active development
      </p>
      <p>
        <ToyProjectBadge /> - project for experimentations
      </p>
      <p>
        <PersonalBadge /> - project for personal needs
      </p>
      <p>
        <ProprietaryBadge /> - commercial project
      </p>
    </section>
    <div class="flex flex-wrap gap-4 sm:w-fit">
      {projects.map((project) => <ProjectCard {project} showBadges />)}
    </div>
  </div>
</RootLayout>
