---
import PersonalBadge from "@/components/badges/personal";
import ProprietaryBadge from "@/components/badges/proprietary";
import ToyProjectBadge from "@/components/badges/toy-project";
import GlassButton from "@/components/glass-button";
import RootLayout from "@/components/root-layout.astro";
import SVGTooltip from "@/components/svg-tooltip";
import {
  Card,
  CardBadges,
  CardDescription,
  CardFooter,
  CardGithubLink,
  CardHeader,
  CardImage,
  CardProjectLink,
  CardSkills,
  CardTitle,
} from "@/components/ui/card";
import { projects } from "@/lib/projects";
import { ArrowLeftIcon } from "lucide-react";
---

<RootLayout className="space-y-4">
  <GlassButton href="/">
    <ArrowLeftIcon className="size-4" />Go back
  </GlassButton>
  <div class="space-y-2">
    <h1 class="text-xl font-bold">Project list ({projects.length})</h1>
    <section class="mb-4 flex flex-col">
      <p>
        <PersonalBadge /> - hobby open-source project, most likely written with regular
        tech stack.
      </p>
      <p>
        <ToyProjectBadge /> - project with unusual tech stack or written just for
        fun.
      </p>
      <p>
        <ProprietaryBadge /> - project licensed under proprietary license.
      </p>
    </section>
    <div class="flex flex-wrap gap-4 sm:w-fit">
      {
        projects.map((project) => (
          <Card>
            <CardHeader>
              <CardBadges>
                {project.badges.map((badge) => {
                  const Badge = badge;
                  return <Badge />;
                })}
              </CardBadges>
              <CardImage {...project.image} />
              <CardTitle>{project.name}</CardTitle>
              <CardDescription>{project.description}</CardDescription>
            </CardHeader>
            <CardSkills>
              {project.techStack.map((tech) => (
                <SVGTooltip client:visible content={tech.title}>
                  <tech.icon />
                </SVGTooltip>
              ))}
            </CardSkills>
            <CardFooter>
              <CardGithubLink githubURL={project.githubURL} />
              <CardProjectLink projectURL={project.projectURL} />
            </CardFooter>
          </Card>
        ))
      }
    </div>
  </div>
</RootLayout>
